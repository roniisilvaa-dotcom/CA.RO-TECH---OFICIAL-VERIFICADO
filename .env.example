# Banco de dados PostgreSQL (Supabase)
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"

# Google Gemini (motor de IA)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Meta WhatsApp Webhook Verify Token
VERIFY_TOKEN="carotech_webhook_token_2026"

# LLM Config
LLM_PROVIDER="gemini"

# Autenticação e criptografia
SESSION_SECRET="troque-por-uma-string-aleatoria-longa"
ENCRYPTION_KEY="troque-por-32-bytes-aleatorios-aqui"

APP_URL="http://localhost:3000"
